{
  "id": "ableton",
  "name": "Ableton Live",
  "version": "0.2.0",
  "publisher": "AeraLabs",
  "capabilities": [
    "software.open",
    "transport.play",
    "transport.stop",
    "transport.record.toggle",
    "track.mute.set",
    "track.solo.set",
    "track.arm.set",
    "track.volume.set",
    "track.pan.set"
  ],
  "platforms": [
    "macos-arm64",
    "macos-x86_64",
    "windows-x86_64"
  ],
  "integrationPriority": [
    "Max for Live Live API",
    "Live Object Model",
    "Control Surface scripts",
    "MIDI fallback"
  ],
  "currentImplementation": {
    "softwareDetection": true,
    "launch": true,
    "transport": true,
    "trackControl": true,
    "projectInspection": true,
    "selectedTrackInspection": true,
    "deviceInspection": true
  },
  "permissions": {
    "software.open": "safe",
    "transport.play": "safe",
    "transport.stop": "safe",
    "transport.record.toggle": "safe",
    "track.mute.set": "reversible",
    "track.solo.set": "reversible",
    "track.arm.set": "reversible",
    "track.volume.set": "reversible",
    "track.pan.set": "reversible"
  },
  "notes": "AERA ships a Max for Live JavaScript companion source using LiveAPI. It publishes verified Set/transport/selected-track/device state and consumes only the shared local AERA DAW command protocol. The user must load it inside a Max for Live device; no UI-coordinate automation is used."
}

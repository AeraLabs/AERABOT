{
  "id": "flstudio",
  "name": "FL Studio",
  "version": "0.2.0",
  "publisher": "AeraLabs",
  "capabilities": [
    "software.open",
    "transport.play",
    "transport.stop",
    "transport.record.toggle",
    "track.mute.set",
    "track.solo.set",
    "track.arm.set",
    "track.volume.set",
    "track.pan.set"
  ],
  "platforms": [
    "macos-arm64",
    "macos-x86_64",
    "windows-x86_64"
  ],
  "integrationPriority": [
    "FL Studio MIDI Scripting Device API",
    "virtual MIDI loopback",
    "foreground-window awareness",
    "accessibility fallback"
  ],
  "currentImplementation": {
    "softwareDetection": true,
    "launch": true,
    "transport": true,
    "trackControl": true,
    "projectInspection": true,
    "selectedTrackInspection": true,
    "pluginInspection": true
  },
  "permissions": {
    "software.open": "safe",
    "transport.play": "safe",
    "transport.stop": "safe",
    "transport.record.toggle": "safe",
    "track.mute.set": "reversible",
    "track.solo.set": "reversible",
    "track.arm.set": "reversible",
    "track.volume.set": "reversible",
    "track.pan.set": "reversible"
  },
  "notes": "AERA installs a local FL Studio MIDI Scripting companion. The script publishes verified project/transport/selected-mixer-track state and executes only allowlisted semantic command envelopes from ~/.aera/bridges/flstudio. No screen-coordinate automation or arbitrary Python execution is exposed."
}

{
  "id": "reaper",
  "name": "REAPER",
  "version": "0.5.0",
  "publisher": "AeraLabs",
  "capabilities": [
    "software.open",
    "transport.play",
    "transport.stop",
    "transport.pause",
    "track.mute.set",
    "track.solo.set",
    "track.arm.set"
  ],
  "platforms": [
    "macos-arm64",
    "macos-x86_64",
    "windows-x86_64"
  ],
  "integrationPriority": [
    "ReaScript",
    "OSC",
    "native-control",
    "accessibility"
  ],
  "currentImplementation": {
    "softwareDetection": true,
    "launch": true,
    "transport": true,
    "trackControl": true,
    "reversibleTrackControl": true,
    "projectInspection": true,
    "liveProjectState": true,
    "trackInspection": true
  },
  "permissions": {
    "software.open": "safe",
    "transport.play": "safe",
    "transport.stop": "safe",
    "transport.pause": "safe",
    "track.mute.set": "reversible",
    "track.solo.set": "reversible",
    "track.arm.set": "reversible"
  },
  "notes": "REAPER launch is native and whitelisted. Transport uses loopback OSC with live verification when the ReaScript bridge is running. The ReaScript publishes verified project/track state and accepts allowlisted reversible mute/solo/arm operations addressed by captured track GUID."
}

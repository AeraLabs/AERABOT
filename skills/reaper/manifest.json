{
  "id": "reaper",
  "name": "REAPER",
  "version": "0.1.0",
  "publisher": "AeraLabs",
  "capabilities": [
    "software.open",
    "transport.play",
    "transport.stop",
    "transport.pause"
  ],
  "platforms": [
    "macos-arm64",
    "macos-x86_64",
    "windows-x86_64"
  ],
  "integrationPriority": [
    "ReaScript",
    "OSC",
    "native-control",
    "accessibility"
  ],
  "currentImplementation": {
    "softwareDetection": true,
    "launch": true,
    "transport": true,
    "trackControl": false,
    "projectInspection": false
  },
  "permissions": {
    "software.open": "safe",
    "transport.play": "safe",
    "transport.stop": "safe",
    "transport.pause": "safe"
  },
  "notes": "REAPER detection/launch is native and whitelisted. Transport uses optional loopback-only OSC when AERA_REAPER_OSC_ENABLED=1; track/project operations remain disabled until backed by validated OSC/ReaScript bridges."
}

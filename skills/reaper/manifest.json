{
  "id": "reaper",
  "name": "REAPER",
  "version": "0.4.0",
  "publisher": "AeraLabs",
  "capabilities": [
    "software.open",
    "transport.play",
    "transport.stop",
    "transport.pause"
  ],
  "platforms": [
    "macos-arm64",
    "macos-x86_64",
    "windows-x86_64"
  ],
  "integrationPriority": [
    "ReaScript",
    "OSC",
    "native-control",
    "accessibility"
  ],
  "currentImplementation": {
    "softwareDetection": true,
    "launch": true,
    "transport": true,
    "trackControl": false,
    "projectInspection": true,
    "liveProjectState": true,
    "trackInspection": true
  },
  "permissions": {
    "software.open": "safe",
    "transport.play": "safe",
    "transport.stop": "safe",
    "transport.pause": "safe"
  },
  "notes": "REAPER launch is native and whitelisted. Transport uses optional loopback-only OSC. A read-only deferred Lua ReaScript can publish live local project/track state to REAPER's Scripts/AERA directory. Mutating track/project operations remain disabled until reversible action semantics are implemented."
}

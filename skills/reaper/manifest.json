{
  "id": "reaper",
  "name": "REAPER",
  "version": "0.6.0",
  "publisher": "AeraLabs",
  "capabilities": [
    "software.open",
    "transport.play",
    "transport.stop",
    "transport.pause",
    "track.select",
    "track.mute.set",
    "track.solo.set",
    "track.arm.set",
    "track.volume.set",
    "track.pan.set",
    "project.inspect",
    "track.fx.inspect"
  ],
  "platforms": [
    "macos-arm64",
    "macos-x86_64",
    "windows-x86_64"
  ],
  "integrationPriority": [
    "ReaScript",
    "OSC",
    "native-control",
    "accessibility"
  ],
  "currentImplementation": {
    "softwareDetection": true,
    "launch": true,
    "transport": true,
    "trackControl": true,
    "trackSelection": true,
    "mixerControl": true,
    "reversibleTrackControl": true,
    "projectInspection": true,
    "liveProjectState": true,
    "trackInspection": true,
    "pluginInspection": true
  },
  "permissions": {
    "software.open": "safe",
    "transport.play": "safe",
    "transport.stop": "safe",
    "transport.pause": "safe",
    "track.select": "reversible",
    "track.mute.set": "reversible",
    "track.solo.set": "reversible",
    "track.arm.set": "reversible",
    "track.volume.set": "reversible",
    "track.pan.set": "reversible",
    "project.inspect": "safe",
    "track.fx.inspect": "safe"
  },
  "notes": "REAPER uses loopback OSC for transport plus a local ReaScript bridge for verified project/track state. Track selection, mute/solo/arm, volume and pan are GUID-addressed, verified after mutation, and journal-reversible. Project and selected-track FX inspection are read-only."
}
